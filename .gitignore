# The build interpreter's virtualenv (DECISIONS.md 15.8). Separate from .venv
# because it is python.org's universal2 framework build, not Homebrew's.
.venv-build/
__pycache__/
*.pyc
.pytest_cache/

# The reading log is personal data, not source.
data/
server.log

# Front end (Phase 2). web/dist is committed as of Phase 4 -- FastAPI serves it.
web/node_modules/
web/*.tsbuildinfo

# Frozen bundle output (DECISIONS.md 15). Anchored with a leading slash so these
# never match the tracked web/dist.
/packaging/dist/
/packaging/build/

