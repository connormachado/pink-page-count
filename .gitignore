.venv/
# The build interpreter's virtualenv (DECISIONS.md 15.8). Separate from .venv
# because it is python.org's universal2 framework build, not Homebrew's.
.venv-build/
__pycache__/
*.pyc
.pytest_cache/

# The reading log is personal data, not source.
data/
server.log

# Front end (Phase 2). web/dist is committed as of Phase 4 -- FastAPI serves it.
web/node_modules/
web/*.tsbuildinfo

# Frozen bundle output (DECISIONS.md 15). Anchored with a leading slash so these
# never match the tracked web/dist.
/packaging/dist/
/packaging/build/

# Other files
build-send-workflow.md

# Release zips. Anchored to the repo root so nothing under web/ or packaging/ is
# caught by accident. A glob rather than a fixed name on purpose: `make zip`
# date-stamps the artifact (DECISIONS.md 15.8.1) and it belongs in
# packaging/dist/, so a rule naming one filename would stop covering it the
# moment the name changes -- which is exactly how a 15 MB build artifact came to
# be sitting at the repo root.
/*.zip

# Finder droppings. Not source, and not this project's business.
.DS_Store
REVIEW.md
